// 3_players_monsters-06
// Bug: the server sends Multicast_PlayLandSound(0) with a hard-coded surface 0, so everyone except the landing player always hears DefaultLanding instead of the Carpet/Metal landing sounds.
// Fix: host part: NetworkSafe_PlayLandSounds is rebuilt with the same logic but passes the real surface type into the existing multicast (same RPC, only the byte value changes). Client part: when the multicast arrives with surface 0 for a remote character, the surface is determined locally with a short downward line trace before the sound is played.

replace NetworkSafe_PlayLandSounds {
    local PM_LandLocal: bool;
    K2Node_CustomEvent_Surface_type = `Surface type`;
    if !HasAuthority() goto notauth;
    Multicast_PlayLandSound(`Surface type`);
notauth:
    SwitchLocallyControlledByPlayer(self, PM_LandLocal);
    if !PM_LandLocal goto done;
    PlayLandSounds(`Surface type`);
done:
}

before Multicast_PlayLandSound {
    local PM_LandHit: struct<HitResult>;
    local PM_LandLoc: struct<Vector>;
    local PM_LandIgnore: array<object<Actor>>;
    if !EqualEqual_ByteByte(Material, 0u8) goto done;
    if !Not_PreBool(IsLocallyControlledByPlayer(self)) goto done;
    PM_LandLoc = K2_GetActorLocation();
    if !LineTraceSingle(self, PM_LandLoc, Subtract_VectorVector(PM_LandLoc, vec(0.0, 0.0, 200.0)), 0u8, false, PM_LandIgnore, 0u8, PM_LandHit, true, LinearColor{1.0, 0.0, 0.0, 1.0}, LinearColor{0.0, 1.0, 0.0, 1.0}, 0.0) goto done;
    Material = GetSurfaceType(PM_LandHit);
done:
}
